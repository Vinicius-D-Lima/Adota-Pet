{
  "name": "adotapet-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @adotapet/web",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm run dev -w @adotapet/web\" \"npm run dev -w @adotapet/api\"",
    "dev:mock": "npm run dev:mock -w @adotapet/web",
    "preview": "npm run preview -w @adotapet/web",
    "mock": "npm run mock -w @adotapet/web",
    "mock:reset": "npm run mock:reset -w @adotapet/web",
    "backend": "npm run dev -w @adotapet/api",
    "build": "npm run build -w @adotapet/shared && npm run build -w @adotapet/web && npm run build -w @adotapet/api",
    "build:web": "npm run build -w @adotapet/web",
    "build:api": "npm run build -w @adotapet/api",
    "build:shared": "npm run build -w @adotapet/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch -w @adotapet/web",
    "test:backend": "npm run test -w @adotapet/api",
    "typecheck:backend": "npm run typecheck -w @adotapet/api",
    "build:backend": "npm run build -w @adotapet/api",
    "db:generate": "npm run db:generate -w @adotapet/api",
    "db:migrate": "npm run db:migrate -w @adotapet/api",
    "db:deploy": "npm run db:deploy -w @adotapet/api",
    "db:push": "npm run db:push -w @adotapet/api",
    "db:reset": "npm run db:reset -w @adotapet/api",
    "db:studio": "npm run db:studio -w @adotapet/api",
    "db:seed": "npm run db:seed -w @adotapet/api",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:workspaces": "node scripts/check-workspaces.mjs",
    "check:shared-imports": "node scripts/check-shared-imports.mjs",
    "check:deps": "node scripts/check-dependency-versions.mjs",
    "check:contract": "node scripts/check-contract-guard.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "zod": "^4.6.5",
    "@casl/ability": "^7.1.3"
  }
}
