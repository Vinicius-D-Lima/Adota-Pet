# URL base da API consumida pelo frontend.
# No projeto, o Vite faz proxy de /api para o backend (3002) ou para o mock (3001 no dev:mock).
VITE_API_URL=/api

# Destino do proxy do Vite. Na maioria dos casos não é preciso definir:
# o padrão é http://localhost:3002 e `npm run dev:mock` ajusta para o mock.
# VITE_API_PROXY_TARGET=http://localhost:3002
