// Contrato de dados do banco (decisão #21: Prisma com migrations versionadas).
// Modelos derivados de mock-server/db.seed.json — o mock é a referência do contrato.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Papel na plataforma (#48). Diferente de `role`/`roles`, que são do contrato do mock.
enum PlatformRole {
  USUARIO
  MODERADOR
}

/// Papel da pessoa dentro da instituição (#26/#28). Guardiões novos começam
/// como ADMIN para preservar o contrato atual; voluntários são explícitos.
enum OrganizationRole {
  ADMIN
  VOLUNTEER
}

enum ReportTargetType {
  USUARIO
  ORGANIZACAO
  ADOCAO
  PET
  AVALIACAO
}

enum ReportCategory {
  MAUS_TRATOS
  ABANDONO
  FRAUDE
  CONTEUDO_IMPROPRIO
  OUTRO
}

enum ReportStatus {
  ABERTA
  EM_ANALISE
  PROCEDENTE
  IMPROCEDENTE
  ARQUIVADA
}

enum MembershipStatus {
  ATIVO
  REMOVIDO
}

enum CheckInStatus {
  PENDENTE
  ENVIADO
  ATRASADO
  REVISADO
}

model User {
  id               String           @id
  name             String           @default("")
  /// Sempre normalizado em minúsculas; a unicidade também é garantida no banco.
  email            String           @unique @default("")
  /// Hash argon2id. Nulo só para usuários legados do mock que ainda não fizeram login.
  passwordHash     String?
  platformRole     PlatformRole     @default(USUARIO)
  organizationRole OrganizationRole @default(ADMIN)
  createdAt        DateTime         @default(now())
  phone            String?
  cpf              String?
  birthDate        String?
  zipCode          String?
  address          String?
  city             String?
  state            String?
  document         String?
  organizationName String?
  guardianType     String?
  role             String           @default("ADOTANTE")
  roles            String[]         @default([])
  lat              Float?
  lng              Float?

  adopterProfile   AdopterProfile?
  guardianProfile  GuardianProfile?
  favorites        Favorite[]
  requests         AdoptionRequest[]
  notifications    Notification[]
  savedFilters     SavedFilter[]
  preferences      NotificationPreference[]
  refreshTokens    RefreshToken[]
  reportsCreated   Report[]                 @relation("ReportReporter")
  reportsModerated Report[]                 @relation("ReportModerator")
  reviewsWritten   Review[]                 @relation("ReviewAuthor")
  reviewsReceived  Review[]                 @relation("ReviewOrganization")
  memberships          Membership[]
  adoptionsAsAdopter   Adoption[]               @relation("Adopter")
  createdFollowUpPlans FollowUpPlan[]           @relation("FollowUpPlanCreator")
}

/// Refresh token fica no banco só como hash (#48): permite revogar e detectar reuso.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdopterProfile {
  id                 Int      @id @default(autoincrement())
  userId             String   @unique
  name               String?
  cpf                String?
  birthDate          String?
  email              String?
  phone              String?
  zipCode            String?
  address            String?
  housing            String?
  hasOutdoorArea     Boolean?
  dailyTime          String?
  activityLevel      String?
  hasChildren        Boolean?
  hasOtherPets       Boolean?
  experience         String?
  acceptsSpecialCare Boolean?
  preferredSpecies   String?
  preferredSize      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GuardianProfile {
  id           Int     @id @default(autoincrement())
  userId       String  @unique
  guardianType String?
  displayName  String?
  legalName    String?
  document     String?
  email        String?
  phone        String?
  zipCode      String?
  address      String?
  city         String?
  description  String?
  acceptsTerms Boolean @default(false)
  reputation   Float?
  reviewCount  Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id           String  @id @default(cuid())
  name         String  @unique
  initials     String
  description  String  @default("")
  city         String  @default("")
  contactEmail String  @default("")
  phone        String  @default("")
  logoUrl      String?
  cnpj         String?

  memberships Membership[]
  adoptions   Adoption[]
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(VOLUNTEER)
  status         MembershipStatus @default(ATIVO)
  joinedAt       DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, status, role])
}

/// Base mínima da issue #25, necessária para a moderação ocultar uma avaliação
/// procedente e recalcular a reputação sem apagar o histórico original.
model Review {
  id             String    @id @default(cuid())
  adoptionId     String
  reviewerId     String
  organizationId String
  rating         Int
  comment        String    @default("")
  hiddenAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reviewer     User @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  organization User @relation("ReviewOrganization", fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([adoptionId, reviewerId])
  @@index([organizationId, hiddenAt])
}

model Report {
  id          String           @id @default(cuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  category    ReportCategory
  description String
  status      ReportStatus     @default(ABERTA)
  resolution  String?
  moderatorId String?
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reporter  User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  moderator User? @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([reporterId, createdAt])
  @@index([status, category, createdAt])
  @@index([targetType, targetId])
}

model Pet {
  id                   String   @id
  name                 String
  species              String
  breed                String
  age                  Int
  ageLabel             String
  size                 String
  sex                  String
  city                 String
  image                String
  gallery              String[] @default([])
  summary              String
  description          String
  traits               String[]
  energy               String
  space                String
  children             Boolean
  otherPets            Boolean
  specialCare          Boolean
  vaccinated           Boolean
  neutered             Boolean
  organization         String
  organizationInitials String
  lat                  Float?
  lng                  Float?
  createdAt            DateTime
  /// #49/#50: só DISPONIVEL aceita solicitação; ADOTADO e ARQUIVADO não.
  status               String   @default("DISPONIVEL")

  favorites Favorite[]
  requests  AdoptionRequest[]
  adoption  Adoption?
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String
  petId     String
  createdAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet  Pet  @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([userId, petId])
}

model AdoptionRequest {
  id              String   @id
  userId          String
  petId           String
  /// Código da máquina de estados (#20): ENVIADA, ANALISE_QUESTIONARIO, ...
  status          String
  /// Controle otimista de concorrência: só a transição que venceu a versão grava.
  version         Int      @default(1)
  date            DateTime
  message         String
  answers         Json?
  interview       Json?
  rejectionReason String?

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet           Pet                    @relation(fields: [petId], references: [id], onDelete: Restrict)
  messages      ChatMessage[]
  statusHistory RequestStatusHistory[]
  adoption      Adoption?
}

/// Auditoria do fluxo (#20): de, para, quem, quando e motivo.
model RequestStatusHistory {
  id         String   @id @default(cuid())
  requestId  String
  fromStatus String
  toStatus   String
  actorId    String
  actorRole  String
  reason     String?
  createdAt  DateTime @default(now())

  request AdoptionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Adoption {
  id             String   @id @default(cuid())
  requestId      String   @unique
  petId          String   @unique
  adopterId      String
  organizationId String
  adoptedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  request      AdoptionRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  pet          Pet             @relation(fields: [petId], references: [id], onDelete: Restrict)
  adopter      User            @relation("Adopter", fields: [adopterId], references: [id], onDelete: Restrict)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         FollowUpPlan?
  checkIns     CheckIn[]

  @@index([adopterId, adoptedAt])
  @@index([organizationId, adoptedAt])
}

model FollowUpPlan {
  id           String    @id @default(cuid())
  adoptionId   String    @unique
  durationDays Int
  intervalDays Int
  createdBy    String
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  adoption Adoption @relation(fields: [adoptionId], references: [id], onDelete: Cascade)
  creator  User     @relation("FollowUpPlanCreator", fields: [createdBy], references: [id], onDelete: Restrict)
}

model CheckIn {
  id              String        @id @default(cuid())
  adoptionId      String
  dueDate         DateTime
  status          CheckInStatus @default(PENDENTE)
  submittedAt     DateTime?
  report          String?
  photos          String[]      @default([])
  reviewerComment String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())

  adoption Adoption @relation(fields: [adoptionId], references: [id], onDelete: Cascade)

  @@index([adoptionId, dueDate])
}

/// Outbox de eventos de domínio (#50): o evento entra na mesma transação da
/// solicitação e o consumidor de notificações (#30/#95) lê depois.
model EventOutbox {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([type, createdAt])
}

/// Idempotência dos consumidores de jobs (#95): uma linha por evento processado.
model JobEffect {
  eventId   String   @id
  type      String
  createdAt DateTime @default(now())
}

/// Armazenamento de arquivos (#94): metadados e vínculo com o registro dono.
/// A chave `key` é sempre gerada pelo servidor; o nome enviado pelo cliente
/// nunca é persistido nem usado como caminho do objeto.
model StorageObject {
  id           String   @id @default(cuid())
  key          String   @unique
  contentType  String
  sizeBytes    Int
  resourceType String
  resourceId   String
  ownerId      String
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([ownerId])
}

model ChatMessage {
  id        String    @id
  requestId String
  authorId  String
  body      String
  createdAt DateTime
  readAt    DateTime?

  request AdoptionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Notification {
  id        String    @id
  userId    String
  type      String
  title     String
  body      String
  link      String
  readAt    DateTime?
  createdAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model NotificationPreference {
  userId String
  type   String
  inApp  Boolean
  email  Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

model SavedFilter {
  id        String   @id
  userId    String
  name      String
  criteria  Json
  active    Boolean
  createdAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
