# Ambiente da API (development | test | production).
NODE_ENV=development

# Porta do servidor Express.
PORT=3002

# String de conexão do PostgreSQL na nuvem (usada pelo Prisma e pelo runtime).
# Obrigatória: sem ela a API não sobe (INF-01).
DATABASE_URL="postgresql://usuario:senha@host:5432/adotapet?sslmode=require"

# Schema usado pelos testes de integração. Se omitida, o setup usa o mesmo
# host com o sufixo _test no nome do database (nunca o banco principal).
# TEST_DATABASE_URL="postgresql://usuario:senha@host:5432/adotapet_test?sslmode=require"

# Origens do frontend liberadas no CORS, separadas por vírgula.
# Padrão: http://localhost:5173. Em produção, coloque a origem real.
CORS_ORIGIN=http://localhost:5173

# Rate limit global e limite do corpo JSON.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# #22: limite específico de envio de mensagens no chat da solicitação.
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT=100kb

# Nível dos logs estruturados (fatal, error, warn, info, debug, trace, silent).
LOG_LEVEL=info

# Usuário demo usado apenas pelos módulos legados que ainda leem X-Demo-User-Id.
# As rotas de autenticação (#48) usam JWT; esse header não autentica ninguém.
DEMO_USER_ID=demo

# Autenticação (#48) — JWT_SECRET é obrigatório: a API não sobe sem ele.
# Use um valor aleatório de pelo menos 32 caracteres em produção.
JWT_SECRET="troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Limite de tentativas de login por IP + e-mail (AUTH-06).
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Cookie do refresh token. Mantenha COOKIE_SECURE=true fora do http local.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
REFRESH_COOKIE_NAME=refresh_token

# Fila de jobs (#95). O schema `pgboss` é criado pela migration versionada.
# JOBS_ENABLED=false sobe a API sem workers (útil para depuração local).
JOBS_ENABLED=true
PG_BOSS_SCHEMA=pgboss
JOBS_SHUTDOWN_TIMEOUT_MS=30000

# Armazenamento de arquivos (#94): API S3 + SeaweedFS/R2/S3, bucket privado.
# Nada disso é versionado. Sem endpoint e sem credenciais, as rotas de storage
# respondem 503 e a API continua subindo.
# SeaweedFS/R2: endpoint obrigatório + forcePathStyle=true. AWS S3: deixe o
# endpoint em branco e use a cadeia de credenciais da SDK.
STORAGE_ENDPOINT=http://127.0.0.1:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=adotapet
STORAGE_ACCESS_KEY_ID=storage-access-key
STORAGE_SECRET_ACCESS_KEY=troque-por-uma-chave-secreta
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL_SECONDS=60
# Opcional; por padrão reusa JWT_SECRET.
# STORAGE_URL_SECRET=troque-por-outra-chave-aleatoria-de-pelo-menos-32-caracteres

# Notificações (#30) — e-mail via SMTP. Sem SMTP_HOST o transporte é JSON
# (nodemailer jsonTransport): a API sobe e os testes passam sem servidor de e-mail.
# Para development, rode o Mailpit como processo local/nativo (sem Docker):
#   mailpit --listen 127.0.0.1:1025 --ui 127.0.0.1:8025
# e descomente as três linhas abaixo. Nos testes, um SMTPServer em processo
# substitui o Mailpit, então nenhum serviço externo é necessário.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM="AdotaPet <nao-resposta@adotapet.local>"
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
