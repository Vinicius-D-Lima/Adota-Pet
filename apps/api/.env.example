# Ambiente da API (development | test | production).
NODE_ENV=development

# Porta do servidor Express.
PORT=3002

# String de conexão do PostgreSQL na nuvem (usada pelo Prisma e pelo runtime).
# Obrigatória: sem ela a API não sobe (INF-01).
DATABASE_URL="postgresql://usuario:senha@host:5432/adotapet?sslmode=require"

# Schema usado pelos testes de integração. Se omitida, o setup usa o mesmo
# host com o sufixo _test no nome do database (nunca o banco principal).
# TEST_DATABASE_URL="postgresql://usuario:senha@host:5432/adotapet_test?sslmode=require"

# Origens do frontend liberadas no CORS, separadas por vírgula.
# Padrão: http://localhost:5173. Em produção, coloque a origem real.
CORS_ORIGIN=http://localhost:5173

# Rate limit global e limite do corpo JSON.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT=100kb

# Nível dos logs estruturados (fatal, error, warn, info, debug, trace, silent).
LOG_LEVEL=info

# Usuário demo usado quando o pedido não envia X-Demo-User-Id (sem JWT ainda).
DEMO_USER_ID=demo
