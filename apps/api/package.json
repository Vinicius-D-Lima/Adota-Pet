{
  "name": "@adotapet/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @adotapet/shared",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build -w @adotapet/shared",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "pretypecheck": "npm run build -w @adotapet/shared",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build -w @adotapet/shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "jobs:redrive": "tsx src/redrive.ts",
    "jobs:status": "tsx src/jobs-status.ts"
  },
  "dependencies": {
    "@adotapet/shared": "*",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "multer": "^2.5.0",
    "nodemailer": "^7.0.13",
    "pg-boss": "^12.39.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/s3rver": "^3.7.4",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.10.1",
    "s3rver": "^3.7.1",
    "smtp-server": "^3.21.7",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
