# Porta do servidor Express.
PORT=3002

# String de conexão do PostgreSQL (usada pelo Prisma e pelo runtime).
DATABASE_URL="postgresql://postgres:password@localhost:5432/adotapet?schema=public"

# Origens liberadas pelo CORS, separadas por vírgula.
# Se vazio, a origem do pedido é refletida (adequado para desenvolvimento).
# CORS_ORIGIN=http://localhost:5173
